    {
      "name": "Recomendação: documentário",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recomendacoes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recomendacoes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo\": \"documentario\",\n  \"nome\": \"Vozes do Sertão\",\n  \"produtor\": \"produtora@exemplo.com\",\n  \"orcamento\": 120000,\n  \"prazo\": \"2027-03-30\",\n  \"localizacao\": \"Recife\",\n  \"detalhes\": {\n    \"tema\": \"Migração no sertão nordestino\",\n    \"entrevistados\": [\n      \"Dona Socorro\",\n      \"Seu Antônio\"\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('projetoId', pm.response.json().projetoId);"
            ]
          }
        }
      ]
    },
