         ]\n              },\n              {\n                \"nome\": \"Mixagem\",\n                \"papel\": \"SONOPLASTA\",\n                \"custo\": 3000,\n                \"prazo\": \"2027-03-25\",\n                \"competencias\": [\n                  {\n                    \"nome\": \"mixagem\",\n                    \"nivel\": 8\n                  }\n                ]\n              }\n            ]\n          }\n        ]\n      }\n    ]\n  },\n  \"detalhes\": {\n    \"tecnica\": \"3d\",\n    \"quadrosPorSegundo\": 24\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
