# Sem DATABASE_URL a API usa o cadastro em memória.
# Com o PostgreSQL do docker-compose rodando (docker compose up -d postgres):
DATABASE_URL=postgresql://cinebridge:cinebridge@localhost:5433/cinebridge

# Provedores (Adapter): local, s3 ou gcs | stripe ou pagseguro | interno ou linkedin.
# S3, Google Cloud, Stripe, PagSeguro e LinkedIn são simulados em memória.
ARMAZENAMENTO=local
ARMAZENAMENTO_DIR=armazenamento
PAGAMENTO=stripe
PROFISSIONAIS=interno

# Pilha de decoradores, de fora para dentro (auditoria, cache, compressao). Vazio desliga todos.
DECORADORES=auditoria,cache,compressao
NIVEL_COMPRESSAO=6
